# Railway frontend service — build-time variable (must be set before deploy/build).
# In Railway: mark this variable as available during the Docker build (passed as ARG).
# Browser calls the public API origin; credentials (beta cookie) require CORS + SameSite support.

NEXT_PUBLIC_API_BASE_URL=https://api.klassenpilot.ai

# Do not set OPENAI_API_KEY on the frontend service.
