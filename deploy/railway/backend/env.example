# Railway backend service — copy values into Railway Variables (or link from a shared env group).
# See deploy/railway/README.md for the full runbook.

# --- Required secrets ---
OPENAI_API_KEY=
# Required for in-plan class materials OCR (Mistral OCR 4).
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Keep OCR scratch on the persistent volume until plan save promotes it.
MATERIALS_SCRATCH_DIR=/data/materials_scratch
# MATERIALS_INDEX_CHARS=1200

# --- Beta identity (Option A: SQLite + file wikis on volume) ---
BETA_ENABLED=true
BETA_DATA_ROOT=/data/beta_data
BETA_COOKIE_NAME=kp_beta_session
BETA_SESSION_DAYS=30
BETA_COOKIE_SECURE=true
# Required for cross-site cookies when FE/API are on different hosts
# (e.g. separate Railway *.up.railway.app URLs). Use "lax" once both
# live under the same site (beta. + api.klassenpilot.ai).
BETA_COOKIE_SAMESITE=none

# --- Model routing vs teacher-visible stream policy ---
# MODEL_PROFILE selects OpenAI model tiers (production = strong model, reasoning-tiered).
# APP_ENV controls whether chat SSE strips raw reasoning/tool args (production strips).
# For hosted beta: production models + visible reasoning traces.
APP_ENV=development
MODEL_PROFILE=production

# Disable operator-only HTTP trace endpoints on a public URL while keeping
# chat reasoning visible (APP_ENV=development). Unset = enabled when APP_ENV=development.
AGENT_TRACE_ENABLED=false

# --- Seed wiki (bundled in image at /app/teacher_wiki) ---
WIKI_ROOT=/app/teacher_wiki

# --- CORS (frontend origin only) ---
CORS_ORIGINS=["https://beta.klassenpilot.ai"]

# --- Optional tuning ---
# OPENAI_STRONG_MODEL=gpt-5.6-terra
# OPENAI_CHEAP_MODEL=gpt-5.4-mini
# AGENT_TIMEOUT_SECONDS=240
# LOG_LEVEL=INFO
