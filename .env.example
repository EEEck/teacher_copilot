# === Backend (copy to backend/.env) ===
OPENAI_API_KEY=sk-your-key-here
# Mistral OCR for in-plan PDF class materials (v1.2). Required for plan PDF
# upload and live OCR tests. Not used by ingest chat.
MISTRAL_API_KEY=
# OCR 4 alias (or pin mistral-ocr-4-0). Primary materials engine.
# OpenAI vision/VLM and Docling are not implemented backups.
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Plan-session OCR scratch (outside wiki) until promote-on-save.
# MATERIALS_SCRATCH_DIR=backend/data/materials_scratch
# Compact materials TOC injected into plan chat (summaries only).
# MATERIALS_INDEX_CHARS=1200
# Two model ids: STRONG (newest/best) and CHEAP (small). Which call class uses
# which, and at what reasoning effort, is decided by MODEL_PROFILE below.
OPENAI_STRONG_MODEL=gpt-5.6-terra
OPENAI_CHEAP_MODEL=gpt-5.4-mini
# MODEL_PROFILE routes three call classes:
#   CHAT (plan+ingest, high volume) | IMPORTANT (Memory Sweep only) | UTILITY (one-shots)
#   production: strong/high         | strong/xhigh                  | strong/minimal   (one model, reasoning-tiered)
#   economy:    cheap/medium        | strong/high                   | cheap/minimal
# Unset derives from APP_ENV (production -> production, else -> economy).
# MODEL_PROFILE=economy
# Per-call-class reasoning effort. Unset = profile default (shown). Values:
# none | minimal | low | medium | high | xhigh.
#   production defaults: chat high | important xhigh | utility minimal
#   economy defaults:    chat medium | important high | utility minimal
# OPENAI_CHAT_REASONING_EFFORT=
# OPENAI_IMPORTANT_REASONING_EFFORT=
# OPENAI_UTILITY_REASONING_EFFORT=
AGENT_TIMEOUT_SECONDS=240
WIKI_ROOT=teacher_wiki
CORS_ORIGINS=["http://localhost:3000"]
# Beta tester mode: one running app, separate tester/workspace identity via
# invite-code login and an HTTP-only session cookie.
BETA_ENABLED=false
BETA_DATA_ROOT=beta_data
BETA_COOKIE_NAME=kp_beta_session
BETA_SESSION_DAYS=30
BETA_COOKIE_SECURE=false
# APP_ENV=development keeps local debug streams raw. APP_ENV=production strips
# teacher-visible streaming reasoning/tool args/tool outputs.
APP_ENV=development
# Plan trace debug endpoint: default on in development, off in production.
# PLAN_TRACE_ENABLED=true

# === Frontend (copy to frontend/.env.local) ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# INTERNAL_API_BASE_URL=http://backend:8010  # Docker Compose SSR only (set in compose.yaml)
