# === Backend (copy to backend/.env) ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=medium
AGENT_TIMEOUT_SECONDS=240
WIKI_ROOT=teacher_wiki
CORS_ORIGINS=["http://localhost:3000"]
# Beta tester mode: one running app, separate tester/workspace identity via
# invite-code login and an HTTP-only session cookie.
BETA_ENABLED=false
BETA_DATA_ROOT=beta_data
BETA_COOKIE_NAME=kp_beta_session
BETA_SESSION_DAYS=30
BETA_COOKIE_SECURE=false
# APP_ENV=development keeps local debug streams raw. APP_ENV=production strips
# teacher-visible streaming reasoning/tool args/tool outputs.
APP_ENV=development
# Plan trace debug endpoint: default on in development, off in production.
# PLAN_TRACE_ENABLED=true

# === Frontend (copy to frontend/.env.local) ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# INTERNAL_API_BASE_URL=http://backend:8010  # Docker Compose SSR only (set in compose.yaml)
